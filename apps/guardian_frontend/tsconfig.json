{
  "extends": "tsconfig-custom/nextjs.json",
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "build/types/**/*.ts"],
  "exclude": ["node_modules", "build", "turbo"],
  "typeRoots": ["./types"],
  "compilerOptions": {
    "downlevelIteration": true,
    "incremental": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./*"],
      "/*": ["./*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  }
}
